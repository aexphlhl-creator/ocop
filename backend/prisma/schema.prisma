datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum RoleName {
  ADMIN
  SELLER
  VISITOR
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

// ==========================================
// MODELS
// ==========================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id                String                   @id @default(uuid()) @db.Uuid
  email             String                   @unique
  passwordHash      String                   @map("password_hash")
  fullName          String                   @map("full_name")
  phone             String?
  roleId            String                   @db.Uuid @map("role_id")
  role              Role                     @relation(fields: [roleId], references: [id])
  isActive          Boolean                  @default(true) @map("is_active")
  businesses        Business[]
  news              News[]
  approvedProducts  Product[]                @relation("ProductApprovedBy")
  approvalHistories ProductApprovalHistory[]
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model Province {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @unique
  code            String     @unique // Mã hành chính chính thức (ví dụ: '01', '79')
  latitude        Float
  longitude       Float
  geojsonPath     String?    @map("geojson_path")
  bounds          Json?
  wards           Ward[]
  businesses      Business[]
  products        Product[]
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("provinces")
}

model Ward {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  provinceId  String     @db.Uuid @map("province_id")
  province    Province   @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  avatar      String?    // Ảnh đại diện xã
  description String?    @db.Text
  geojsonPath String?    @map("geojson_path")
  bounds      Json?
  businesses  Business[]
  products    Product[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("wards")
}

model Business {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  taxCode    String    @unique @map("tax_code")
  phone      String?
  email      String?
  address    String
  userId     String    @db.Uuid @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  wardId     String    @db.Uuid @map("ward_id")
  ward       Ward      @relation(fields: [wardId], references: [id])
  provinceId String    @db.Uuid @map("province_id")
  province   Province  @relation(fields: [provinceId], references: [id])
  isVerified Boolean   @default(false) @map("is_verified")
  products   Product[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([userId])
  @@index([wardId])
  @@index([provinceId])
  @@map("businesses")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model OcopLevel {
  id        String    @id @default(uuid()) @db.Uuid
  level     Int       @unique // 3, 4, 5
  title     String    // 3 Sao, 4 Sao, 5 Sao
  icon      String?
  color     String?
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("ocop_levels")
}

model Product {
  id                String                   @id @default(uuid()) @db.Uuid
  name              String
  slug              String                   @unique
  description       String                   @db.Text
  price             Decimal                  @db.Decimal(12, 2)
  unit              String                   // Ví dụ: Hộp, Gói, Kg...
  ocopLevelId       String                   @db.Uuid @map("ocop_level_id")
  ocopLevel         OcopLevel                @relation(fields: [ocopLevelId], references: [id])
  categoryId        String                   @db.Uuid @map("category_id")
  category          Category                 @relation(fields: [categoryId], references: [id])
  businessId        String                   @db.Uuid @map("business_id")
  business          Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  wardId            String                   @db.Uuid @map("ward_id")
  ward              Ward                     @relation(fields: [wardId], references: [id])
  provinceId        String                   @db.Uuid @map("province_id")
  province          Province                 @relation(fields: [provinceId], references: [id])
  latitude          Float
  longitude         Float
  status            ProductStatus            @default(PENDING)
  approvedAt        DateTime?                @map("approved_at")
  approvedById      String?                  @db.Uuid @map("approved_by_id")
  approvedBy        User?                    @relation("ProductApprovedBy", fields: [approvedById], references: [id])
  rejectReason      String?                  @map("reject_reason") @db.Text
  approvalHistories ProductApprovalHistory[]
  videoUrl          String?                  @map("video_url")
  images            ProductImage[]
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  deletedAt         DateTime?                @map("deleted_at")

  @@index([ocopLevelId])
  @@index([categoryId])
  @@index([businessId])
  @@index([wardId])
  @@index([provinceId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_images")
}

model News {
  id        String     @id @default(uuid()) @db.Uuid
  title     String
  slug      String     @unique
  content   String     @db.Text
  thumbnail String
  authorId  String     @db.Uuid @map("author_id")
  author    User       @relation(fields: [authorId], references: [id])
  status    NewsStatus @default(DRAFT)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  @@index([authorId])
  @@index([status])
  @@map("news")
}

model ProductApprovalHistory {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @db.Uuid @map("product_id")
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  adminId    String        @db.Uuid @map("admin_id")
  admin      User          @relation(fields: [adminId], references: [id])
  oldStatus  ProductStatus @map("old_status")
  newStatus  ProductStatus @map("new_status")
  reason     String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([productId])
  @@index([adminId])
  @@map("product_approval_histories")
}
