NODE_ENV=production
DEMO_MODE=false
PORT=3000
CORS_ORIGIN=https://your-vercel-domain.vercel.app
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

REDIS_URL=rediss://default:PASSWORD@HOST:PORT
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id
VNPAY_TMN_CODE=your-vnpay-merchant-code
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://your-vercel-domain.vercel.app/checkout/callback

MINIO_ENDPOINT=account-id.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-with-r2-access-key
MINIO_SECRET_KEY=replace-with-r2-secret-key
MINIO_BUCKET=ocop-demo
MINIO_BUCKET_NAME=ocop-demo
MINIO_PUBLIC_URL=https://media.your-domain.com

CARRIER_WEBHOOK_SECRETS={"GHN":"replace-with-carrier-webhook-hmac-secret-min-32-chars","GHTK":"replace-with-carrier-webhook-hmac-secret-min-32-chars"}

POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=
POLYGON_CHAIN_ID=80002
CONTRACT_ADDRESS=
